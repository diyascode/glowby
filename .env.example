# Copy of the environment variables Glowby needs.
# NEVER put real keys in this file or in the code.
# On Railway: paste real values under your service's "Variables" tab.

# Powers the agents (console.anthropic.com)
ANTHROPIC_API_KEY=

# Whisper transcription (platform.openai.com)
OPENAI_API_KEY=

# YouTube Data API (console.cloud.google.com)
YOUTUBE_API_KEY=

# Provided automatically by Railway when you add the PostgreSQL database
DATABASE_URL=
